#!/usr/bin/env bash
# Stow (or re-stow) a dotfile package into $HOME from the common and active-host tiers.
# The active host is read from the .host file at the repo root.
# Usage: stow-add <package>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") <package>" >&2
  exit 2
fi

pkg=$1
# shellcheck source=_stow-lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/_stow-lib.sh"

for tier in "${TIERS[@]}"; do
  stow -d "$tier" -t "$HOME" --restow --verbose=2 "$pkg"
done
