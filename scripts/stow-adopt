#!/usr/bin/env bash
# Adopt existing files from $HOME into ./dotfiles/<tier>/<package>, replacing them with symlinks.
# WARNING: --adopt overwrites the in-repo copy with whatever is in $HOME. Review git diff after.
# Adopts across both the common and active-host tiers (whichever contain the package).
# The active host is read from the .host file at the repo root.
# Usage: stow-adopt <package>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") <package>" >&2
  exit 2
fi

pkg=$1
# shellcheck source=_stow-lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/_stow-lib.sh"

for tier in "${TIERS[@]}"; do
  stow -d "$tier" -t "$HOME" --adopt --verbose=2 "$pkg"
done
echo
echo "Adopt complete. Review changes with: git status dotfiles/*/$pkg && git diff dotfiles/*/$pkg" >&2
