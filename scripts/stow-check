#!/usr/bin/env bash
# Dry-run a stow operation to preview symlinks and conflicts across the common and
# active-host tiers. The active host is read from the .host file at the repo root.
# Usage: stow-check <package>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") <package>" >&2
  exit 2
fi

pkg=$1
# shellcheck source=_stow-lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/_stow-lib.sh"

for tier in "${TIERS[@]}"; do
  echo "# dry-run: $tier/$pkg" >&2
  stow -d "$tier" -t "$HOME" --no --verbose=2 --restow "$pkg"
done
