#!/usr/bin/env bash
# Remove (unstow) a dotfile package's symlinks from $HOME. Source in ./dotfiles is untouched.
# Removes from both the common and active-host tiers (whichever contain the package).
# The active host is read from the .host file at the repo root.
# Usage: stow-remove <package>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") <package>" >&2
  exit 2
fi

pkg=$1
# shellcheck source=_stow-lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/_stow-lib.sh"

for tier in "${TIERS[@]}"; do
  stow -d "$tier" -t "$HOME" --delete --verbose=2 "$pkg"
done
