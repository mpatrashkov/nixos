{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "claude"
      }
    }
  },
  "enabled_providers": ["github-copilot", "amazon-bedrock"],
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "lsp": true,
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "grafana": {
      "type": "local",
      "command": ["/Users/miroslav.patrashkov/go/bin/mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "https://grafana.trading212.avus.io/",
        "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "lokalise_pm": {
      "type": "remote",
      "url": "https://mcp.lokalise.com/mcp/project-management",
      "enabled": true
    },
    "lokalise_sd": {
      "type": "remote",
      "url": "https://mcp.lokalise.com/mcp/software-development",
      "enabled": true
    }
  }
}
